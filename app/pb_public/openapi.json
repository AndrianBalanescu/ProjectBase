{
  "openapi": "3.1.0",
  "info": {
    "title": "ProjectBase API",
    "version": "1.0.0",
    "description": "High-performance, ultra-lightweight Plane & Linear alternative for multi-project Kanban, sprint cycles, and autonomous AI agent orchestration.",
    "contact": {
      "name": "Andrian Balanescu",
      "url": "https://github.com/AndrianBalanescu/projectbase"
    },
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "/api",
      "description": "ProjectBase REST API base"
    }
  ],
  "tags": [
    {
      "name": "Agent Quick Tasks",
      "description": "Convenience endpoints designed for autonomous AI agents"
    },
    {
      "name": "Projects",
      "description": "Project and repository workspace management"
    },
    {
      "name": "Issues",
      "description": "Work items, Kanban tasks, subtasks, and estimates"
    },
    {
      "name": "Cycles",
      "description": "Timeboxed sprint cycles and burndown velocity"
    },
    {
      "name": "Comments",
      "description": "Execution audit trail, discussions, and agent progress logs"
    },
    {
      "name": "System",
      "description": "Health monitoring and workspace velocity analytics"
    },
    {
      "name": "Importers",
      "description": "Bulk issue importers (CSV / GitHub)"
    },
    {
      "name": "Notifications",
      "description": "In-app notification inbox operations"
    },
    {
      "name": "AI Assist",
      "description": "AI copilot endpoints for subtask generation, description polish, and sprint summaries"
    },
    {
      "name": "Agent Dispatch",
      "description": "Autonomous agent dispatch and job triggers"
    },
    {
      "name": "Bulk Actions",
      "description": "Batch operations for the board/list multi-select workflow"
    },
    {
      "name": "Search",
      "description": "Global cross-project issue search"
    }
  ],
  "paths": {
    "/projectbase/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Service Health Check",
        "responses": {
          "200": {
            "description": "Healthy"
          }
        }
      }
    },
    "/projectbase/stats": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Workspace Velocity & Statistics",
        "responses": {
          "200": {
            "description": "Statistics"
          }
        }
      }
    },
    "/projectbase/quick-task": {
      "post": {
        "tags": [
          "Agent Quick Tasks"
        ],
        "summary": "Fast Agent Task Creation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title"
                ],
                "properties": {
                  "project_key": {
                    "type": "string",
                    "example": "LOAD"
                  },
                  "title": {
                    "type": "string",
                    "example": "Dispatch load #402"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "backlog",
                      "todo",
                      "in_progress",
                      "in_review",
                      "done",
                      "cancelled"
                    ],
                    "default": "todo"
                  },
                  "priority": {
                    "type": "string",
                    "enum": [
                      "urgent",
                      "high",
                      "medium",
                      "low",
                      "none"
                    ],
                    "default": "medium"
                  },
                  "estimate": {
                    "type": "integer",
                    "example": 3
                  },
                  "assignee": {
                    "type": "string",
                    "example": "Flomaster Agent"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/collections/projects/records": {
      "get": {
        "tags": [
          "Projects"
        ],
        "summary": "List Projects",
        "responses": {
          "200": {
            "description": "List"
          }
        }
      },
      "post": {
        "tags": [
          "Projects"
        ],
        "summary": "Create Project",
        "responses": {
          "200": {
            "description": "Created"
          }
        }
      }
    },
    "/collections/issues/records": {
      "get": {
        "tags": [
          "Issues"
        ],
        "summary": "List Issues / Tasks",
        "responses": {
          "200": {
            "description": "List"
          }
        }
      },
      "post": {
        "tags": [
          "Issues"
        ],
        "summary": "Create Issue",
        "responses": {
          "200": {
            "description": "Created"
          }
        }
      }
    },
    "/collections/issues/records/{id}": {
      "get": {
        "tags": [
          "Issues"
        ],
        "summary": "Get Issue",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Item"
          }
        }
      },
      "patch": {
        "tags": [
          "Issues"
        ],
        "summary": "Update Issue",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated"
          }
        }
      },
      "delete": {
        "tags": [
          "Issues"
        ],
        "summary": "Delete Issue",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          }
        }
      }
    },
    "/collections/cycles/records": {
      "get": {
        "tags": [
          "Cycles"
        ],
        "summary": "List Cycles",
        "responses": {
          "200": {
            "description": "List"
          }
        }
      },
      "post": {
        "tags": [
          "Cycles"
        ],
        "summary": "Create Cycle",
        "responses": {
          "200": {
            "description": "Created"
          }
        }
      }
    },
    "/collections/comments/records": {
      "get": {
        "tags": [
          "Comments"
        ],
        "summary": "List Comments",
        "responses": {
          "200": {
            "description": "List"
          }
        }
      },
      "post": {
        "tags": [
          "Comments"
        ],
        "summary": "Post Comment",
        "responses": {
          "200": {
            "description": "Created"
          }
        }
      }
    },
    "/projectbase/projects/{id}/custom-fields": {
      "get": {
        "tags": [
          "Projects"
        ],
        "summary": "List Custom Field Definitions",
        "description": "Returns the ordered list of custom field definitions for a project (Linear-style properties). Field types: text, number, select, checkbox, date.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Project record id"
          }
        ],
        "responses": {
          "200": {
            "description": "Custom field definitions array",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "fields": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "key": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string",
                            "enum": [
                              "text",
                              "number",
                              "select",
                              "checkbox",
                              "date"
                            ]
                          },
                          "required": {
                            "type": "boolean"
                          },
                          "options": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Project not found"
          }
        }
      },
      "put": {
        "tags": [
          "Projects"
        ],
        "summary": "Replace Custom Field Definitions",
        "description": "Replaces the full ordered list of custom field definitions for a project. Labels/options capped at 120 chars, max 50 fields.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Project record id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "fields"
                ],
                "properties": {
                  "fields": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string",
                          "enum": [
                            "text",
                            "number",
                            "select",
                            "checkbox",
                            "date"
                          ],
                          "default": "text"
                        },
                        "required": {
                          "type": "boolean",
                          "default": false
                        },
                        "options": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated definitions"
          },
          "400": {
            "description": "Invalid field definition"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Project not found"
          }
        }
      }
    },
    "/projectbase/projects/{id}/custom-fields/validate": {
      "post": {
        "tags": [
          "Projects"
        ],
        "summary": "Validate Issue Custom Field Values",
        "description": "Validates a proposed custom_fields payload against the project's definitions. Returns 200 valid or 422 with an error string.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Project record id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "values"
                ],
                "properties": {
                  "values": {
                    "type": "object",
                    "description": "Map of field key -> value"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Valid",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "valid": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Project not found"
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/projectbase/issues/{id}/relations": {
      "get": {
        "tags": [
          "Issues"
        ],
        "summary": "List Issue Relationships",
        "description": "Returns the resolved outgoing relations (blocks / blocked_by / related) plus every incoming mirror edge for an issue.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Issue record id"
          }
        ],
        "responses": {
          "200": {
            "description": "Relations with resolved target issue details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "outgoing": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "issue": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string",
                            "enum": [
                              "blocks",
                              "blocked_by",
                              "related"
                            ]
                          },
                          "target": {
                            "type": "object"
                          }
                        }
                      }
                    },
                    "incoming": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "issue": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string",
                            "enum": [
                              "blocks",
                              "blocked_by",
                              "related"
                            ]
                          },
                          "target": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Issue not found"
          }
        }
      },
      "post": {
        "tags": [
          "Issues"
        ],
        "summary": "Add Issue Relationship",
        "description": "Links two issues (blocks / blocked_by / related). The reciprocal edge is mirrored automatically (A blocks B <=> B blocked_by A).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Source issue record id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "issue": {
                    "type": "string",
                    "description": "Target issue record id"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "blocks",
                      "blocked_by",
                      "related"
                    ]
                  }
                },
                "required": [
                  "issue",
                  "type"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Relation added (and mirrored)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "relations": {
                      "type": "array"
                    },
                    "mirrored": {
                      "type": "boolean"
                    },
                    "already": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid type, body, or self-relation"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Issue not found"
          }
        }
      },
      "delete": {
        "tags": [
          "Issues"
        ],
        "summary": "Remove Issue Relationship",
        "description": "Removes a relation edge and its reciprocal mirror.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Source issue record id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "issue": {
                    "type": "string",
                    "description": "Target issue record id"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "blocks",
                      "blocked_by",
                      "related"
                    ]
                  }
                },
                "required": [
                  "issue",
                  "type"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Relation removed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "relations": {
                      "type": "array"
                    },
                    "unmirrored": {
                      "type": "boolean"
                    },
                    "removed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid type or body"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Issue not found"
          }
        }
      }
    },
    "/projectbase/version": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Service Version",
        "responses": {
          "200": {
            "description": "Version information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "version": {
                      "type": "string",
                      "example": "1.0.0"
                    },
                    "service": {
                      "type": "string",
                      "example": "ProjectBase"
                    },
                    "license": {
                      "type": "string",
                      "example": "MIT"
                    },
                    "open_source": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/projectbase/import/csv": {
      "post": {
        "tags": [
          "Importers"
        ],
        "summary": "Import Issues from CSV Rows",
        "description": "Bulk-create issues from an array of row objects. Rows map loosely to issue fields (title, description, status, priority, assignee, due_date, estimate, labels, source_key). Idempotent on matching titles/source keys.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "project_id",
                  "rows"
                ],
                "properties": {
                  "project_id": {
                    "type": "string",
                    "description": "Project record id"
                  },
                  "rows": {
                    "type": "array",
                    "maxItems": 5000,
                    "items": {
                      "type": "object",
                      "properties": {
                        "title": {
                          "type": "string",
                          "example": "Fix checkout flow"
                        },
                        "description": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "backlog",
                            "todo",
                            "in_progress",
                            "in_review",
                            "done",
                            "cancelled"
                          ]
                        },
                        "priority": {
                          "type": "string",
                          "enum": [
                            "urgent",
                            "high",
                            "medium",
                            "low",
                            "none"
                          ]
                        },
                        "assignee": {
                          "type": "string"
                        },
                        "start_date": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "example": "2026-08-24 00:00:00.000Z"
                        },
                        "due_date": {
                          "type": "string"
                        },
                        "estimate": {
                          "type": "integer"
                        },
                        "labels": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "source_key": {
                          "type": "string"
                        },
                        "source_type": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Import summary",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "imported": {
                      "type": "integer"
                    },
                    "skipped": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "project": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing/empty rows, or >5000 rows"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Project not found"
          }
        }
      }
    },
    "/projectbase/import/github": {
      "post": {
        "tags": [
          "Importers"
        ],
        "summary": "Import Issues from a GitHub Repository",
        "description": "Fetch issues from a public (or PAT-authenticated) GitHub repo and import them into a project. Idempotent: keyed by GitHub issue number via source_metadata.source_key. Optionally passes a GitHub Personal Access Token for private repos.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "project_id",
                  "repo"
                ],
                "properties": {
                  "project_id": {
                    "type": "string"
                  },
                  "repo": {
                    "type": "string",
                    "example": "owner/repo"
                  },
                  "token": {
                    "type": "string",
                    "description": "Optional GitHub PAT for private repos"
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "all",
                      "open",
                      "closed"
                    ],
                    "default": "all"
                  },
                  "max_issues": {
                    "type": "integer",
                    "maximum": 5000,
                    "default": 1000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Import summary",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "imported": {
                      "type": "integer"
                    },
                    "skipped": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    },
                    "repo": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "rate_limit": {
                      "type": "object",
                      "properties": {
                        "remaining": {
                          "type": "integer"
                        },
                        "reset_at": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing project_id, invalid repo, or >5000 max_issues"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Project not found"
          }
        }
      }
    },
    "/projectbase/export/json": {
      "get": {
        "tags": [
          "Export"
        ],
        "summary": "Export Issues (JSON)",
        "description": "Download a project's issues as a machine-readable JSON document. Mirrors the importer fields so an exported file can be re-imported elsewhere.",
        "parameters": [
          {
            "name": "project",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Project record id"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/projectbase/export/csv": {
      "get": {
        "tags": [
          "Export"
        ],
        "summary": "Export Issues (CSV)",
        "description": "Download a project's issues as a CSV attachment. Header mirrors the importer columns (title,description,status,priority,assignee,start_date,due_date,estimate,labels,source_key,custom_fields) so the file can be re-imported.",
        "parameters": [
          {
            "name": "project",
            "in": "query",
            "required": "True",
            "schema": {
              "type": "string"
            },
            "description": "Project record id"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/projectbase/notifications/read-all": {
      "post": {
        "tags": [
          "Notifications"
        ],
        "summary": "Mark All Notifications Read",
        "description": "Marks every unread notification for the current user as read. Returns the number of rows updated.",
        "responses": {
          "200": {
            "description": "Number of notifications marked read",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "updated": {
                      "type": "integer",
                      "example": 3
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },
    "/projectbase/ai-assist": {
      "post": {
        "tags": [
          "AI Assist"
        ],
        "summary": "AI Copilot Assistance",
        "description": "Generate subtasks, polish an issue description, or summarize a sprint cycle using a configured LLM. Falls back to deterministic heuristics when the LLM is unreachable.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "generate_subtasks",
                      "polish_description",
                      "summarize_cycle"
                    ]
                  },
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "issues": {
                    "type": "array",
                    "description": "Required for summarize_cycle",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "AI result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "action": {
                      "type": "string"
                    },
                    "used_llm": {
                      "type": "boolean"
                    },
                    "subtasks": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "description": {
                      "type": "string"
                    },
                    "result": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Title or description required (for subtasks/polish)"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },
    "/projectbase/dispatch-agent": {
      "post": {
        "tags": [
          "Agent Dispatch"
        ],
        "summary": "Dispatch an Autonomous Agent",
        "description": "Mark an issue in_progress, assign it to the target agent, and optionally forward the task to a configured Windmill/agent webhook. Returns the updated issue state and whether it was dispatched externally.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "issue_id"
                ],
                "properties": {
                  "issue_id": {
                    "type": "string",
                    "description": "Issue record id (10-20 alphanumeric chars)"
                  },
                  "agent_target": {
                    "type": "string",
                    "enum": [
                      "flomaster",
                      "hermes",
                      "windmill",
                      "custom"
                    ],
                    "default": "flomaster"
                  },
                  "prompt": {
                    "type": "string",
                    "maxLength": 8000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Dispatch result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "issue": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "identifier": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string"
                        },
                        "assignee": {
                          "type": "string"
                        }
                      }
                    },
                    "dispatched_external": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing/invalid issue_id, invalid agent_target, or prompt >8000 chars"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Issue not found"
          }
        }
      }
    },
    "/projectbase/issues/bulk-update": {
      "post": {
        "tags": [
          "Bulk Actions"
        ],
        "summary": "Bulk Update Issues",
        "description": "Update one or more fields on up to 500 issues in a single request (board/list multi-select). Each record is saved through the standard hooks, so the activity audit and realtime SSE fire per record.",
        "security": [
          {
            "PBUserAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ids",
                  "data"
                ],
                "properties": {
                  "ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "example": "abc123def456ghi789"
                    },
                    "description": "Issue record ids to update (max 500)",
                    "maxItems": 500,
                    "minItems": 1
                  },
                  "data": {
                    "type": "object",
                    "description": "Field updates. Only whitelisted fields are allowed; per-project custom fields use the custom_ prefix.",
                    "properties": {
                      "status": {
                        "type": "string",
                        "enum": [
                          "backlog",
                          "todo",
                          "in_progress",
                          "in_review",
                          "done",
                          "cancelled"
                        ]
                      },
                      "priority": {
                        "type": "string",
                        "enum": [
                          "urgent",
                          "high",
                          "medium",
                          "low",
                          "none"
                        ]
                      },
                      "cycle": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "example": "admzsfez5xsxyeu",
                        "description": "Cycle record id or null/empty to clear"
                      },
                      "milestone": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Milestone record id or null/empty to clear"
                      },
                      "estimate": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9999
                      },
                      "start_date": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "example": "2026-08-24 00:00:00.000Z"
                      },
                      "due_date": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "example": "2026-09-01 00:00:00.000Z"
                      },
                      "labels": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 64
                        }
                      },
                      "order": {
                        "type": "number"
                      }
                    },
                    "additionalProperties": {
                      "type": "string",
                      "description": "Per-project custom field values (custom_* prefix)"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bulk update summary",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "updated": {
                      "type": "integer"
                    },
                    "missing": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error (bad ids/data/field value)"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/projectbase/issues/bulk-delete": {
      "post": {
        "tags": [
          "Bulk Actions"
        ],
        "summary": "Bulk Delete Issues",
        "description": "Delete up to 500 issues in a single request. Requires an admin or manager role (mirrors the issues collection deleteRule).",
        "security": [
          {
            "PBUserAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ids"
                ],
                "properties": {
                  "ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Issue record ids to delete (max 500)",
                    "maxItems": 500,
                    "minItems": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bulk delete summary",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": {
                      "type": "integer"
                    },
                    "missing": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient role (member)"
          }
        }
      }
    },
    "/projectbase/search": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "Global Cross-Project Issue Search",
        "description": "Search issues across every project by title, identifier, status, or priority. Used by the Cmd+K omnibox.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Search query (max 128 chars)"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20
            },
            "description": "Max results (max 50)"
          }
        ],
        "responses": {
          "200": {
            "description": "Search results"
          },
          "401": {
            "description": "Authentication required"
          },
          "400": {
            "description": "Invalid query"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/projectbase/notification-settings": {
      "get": {
        "tags": [
          "Notifications"
        ],
        "summary": "Get Notification Channel Settings",
        "description": "Read the current Discord/Telegram/generic-webhook notification channel configuration. Admin/manager/superuser only. Values come from the notification_settings collection, falling back to process environment.",
        "responses": {
          "200": {
            "description": "Current channel settings"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin or manager role required"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "put": {
        "tags": [
          "Notifications"
        ],
        "summary": "Update Notification Channel Settings",
        "description": "Persist Discord/Telegram/generic-webhook notification channel configuration so it applies immediately without a process restart. Admin/agent only.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "discord_webhook_url": {
                    "type": "string"
                  },
                  "telegram_token": {
                    "type": "string"
                  },
                  "telegram_chat_id": {
                    "type": "string"
                  },
                  "generic_webhook_url": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated channel settings"
          },
          "400": {
            "description": "Invalid JSON body"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin or manager role required"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  }
}