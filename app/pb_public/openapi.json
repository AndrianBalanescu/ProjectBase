{
  "openapi": "3.1.0",
  "info": {
    "title": "ProjectBase API",
    "version": "0.9.0",
    "description": "High-performance, ultra-lightweight Plane & Linear alternative for multi-project Kanban, sprint cycles, and autonomous AI agent orchestration.",
    "contact": {
      "name": "Andrian Balanescu",
      "url": "https://github.com/AndrianBalanescu/projectbase"
    },
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "/api",
      "description": "ProjectBase REST API base"
    }
  ],
  "tags": [
    {
      "name": "Agent Quick Tasks",
      "description": "Convenience endpoints designed for autonomous AI agents"
    },
    {
      "name": "Projects",
      "description": "Project and repository workspace management"
    },
    {
      "name": "Issues",
      "description": "Work items, Kanban tasks, subtasks, and estimates"
    },
    {
      "name": "Cycles",
      "description": "Timeboxed sprint cycles and burndown velocity"
    },
    {
      "name": "Comments",
      "description": "Execution audit trail, discussions, and agent progress logs"
    },
    {
      "name": "System",
      "description": "Health monitoring and workspace velocity analytics"
    }
  ],
  "paths": {
    "/projectbase/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Service Health Check",
        "responses": {
          "200": {
            "description": "Healthy"
          }
        }
      }
    },
    "/projectbase/stats": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Workspace Velocity & Statistics",
        "responses": {
          "200": {
            "description": "Statistics"
          }
        }
      }
    },
    "/projectbase/quick-task": {
      "post": {
        "tags": [
          "Agent Quick Tasks"
        ],
        "summary": "Fast Agent Task Creation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title"
                ],
                "properties": {
                  "project_key": {
                    "type": "string",
                    "example": "LOAD"
                  },
                  "title": {
                    "type": "string",
                    "example": "Dispatch load #402"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "backlog",
                      "todo",
                      "in_progress",
                      "in_review",
                      "done",
                      "cancelled"
                    ],
                    "default": "todo"
                  },
                  "priority": {
                    "type": "string",
                    "enum": [
                      "urgent",
                      "high",
                      "medium",
                      "low",
                      "none"
                    ],
                    "default": "medium"
                  },
                  "estimate": {
                    "type": "integer",
                    "example": 3
                  },
                  "assignee": {
                    "type": "string",
                    "example": "Flomaster Agent"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/collections/projects/records": {
      "get": {
        "tags": [
          "Projects"
        ],
        "summary": "List Projects",
        "responses": {
          "200": {
            "description": "List"
          }
        }
      },
      "post": {
        "tags": [
          "Projects"
        ],
        "summary": "Create Project",
        "responses": {
          "200": {
            "description": "Created"
          }
        }
      }
    },
    "/collections/issues/records": {
      "get": {
        "tags": [
          "Issues"
        ],
        "summary": "List Issues / Tasks",
        "responses": {
          "200": {
            "description": "List"
          }
        }
      },
      "post": {
        "tags": [
          "Issues"
        ],
        "summary": "Create Issue",
        "responses": {
          "200": {
            "description": "Created"
          }
        }
      }
    },
    "/collections/issues/records/{id}": {
      "get": {
        "tags": [
          "Issues"
        ],
        "summary": "Get Issue",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Item"
          }
        }
      },
      "patch": {
        "tags": [
          "Issues"
        ],
        "summary": "Update Issue",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated"
          }
        }
      },
      "delete": {
        "tags": [
          "Issues"
        ],
        "summary": "Delete Issue",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          }
        }
      }
    },
    "/collections/cycles/records": {
      "get": {
        "tags": [
          "Cycles"
        ],
        "summary": "List Cycles",
        "responses": {
          "200": {
            "description": "List"
          }
        }
      },
      "post": {
        "tags": [
          "Cycles"
        ],
        "summary": "Create Cycle",
        "responses": {
          "200": {
            "description": "Created"
          }
        }
      }
    },
    "/collections/comments/records": {
      "get": {
        "tags": [
          "Comments"
        ],
        "summary": "List Comments",
        "responses": {
          "200": {
            "description": "List"
          }
        }
      },
      "post": {
        "tags": [
          "Comments"
        ],
        "summary": "Post Comment",
        "responses": {
          "200": {
            "description": "Created"
          }
        }
      }
    },
    "/projectbase/projects/{id}/custom-fields": {
      "get": {
        "tags": [
          "Projects"
        ],
        "summary": "List Custom Field Definitions",
        "description": "Returns the ordered list of custom field definitions for a project (Linear-style properties). Field types: text, number, select, checkbox, date.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Project record id"
          }
        ],
        "responses": {
          "200": {
            "description": "Custom field definitions array",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "fields": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "key": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string",
                            "enum": [
                              "text",
                              "number",
                              "select",
                              "checkbox",
                              "date"
                            ]
                          },
                          "required": {
                            "type": "boolean"
                          },
                          "options": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Project not found"
          }
        }
      },
      "put": {
        "tags": [
          "Projects"
        ],
        "summary": "Replace Custom Field Definitions",
        "description": "Replaces the full ordered list of custom field definitions for a project. Labels/options capped at 120 chars, max 50 fields.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Project record id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "fields"
                ],
                "properties": {
                  "fields": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string",
                          "enum": [
                            "text",
                            "number",
                            "select",
                            "checkbox",
                            "date"
                          ],
                          "default": "text"
                        },
                        "required": {
                          "type": "boolean",
                          "default": false
                        },
                        "options": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated definitions"
          },
          "400": {
            "description": "Invalid field definition"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Project not found"
          }
        }
      }
    },
    "/projectbase/projects/{id}/custom-fields/validate": {
      "post": {
        "tags": [
          "Projects"
        ],
        "summary": "Validate Issue Custom Field Values",
        "description": "Validates a proposed custom_fields payload against the project's definitions. Returns 200 valid or 422 with an error string.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Project record id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "values"
                ],
                "properties": {
                  "values": {
                    "type": "object",
                    "description": "Map of field key -> value"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Valid",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "valid": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Project not found"
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/projectbase/issues/{id}/relations": {
      "get": {
        "tags": [
          "Issues"
        ],
        "summary": "List Issue Relationships",
        "description": "Returns the resolved outgoing relations (blocks / blocked_by / related) plus every incoming mirror edge for an issue.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Issue record id"
          }
        ],
        "responses": {
          "200": {
            "description": "Relations with resolved target issue details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "outgoing": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "issue": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string",
                            "enum": [
                              "blocks",
                              "blocked_by",
                              "related"
                            ]
                          },
                          "target": {
                            "type": "object"
                          }
                        }
                      }
                    },
                    "incoming": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "issue": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string",
                            "enum": [
                              "blocks",
                              "blocked_by",
                              "related"
                            ]
                          },
                          "target": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Issue not found"
          }
        }
      },
      "post": {
        "tags": [
          "Issues"
        ],
        "summary": "Add Issue Relationship",
        "description": "Links two issues (blocks / blocked_by / related). The reciprocal edge is mirrored automatically (A blocks B <=> B blocked_by A).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Source issue record id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "issue": {
                    "type": "string",
                    "description": "Target issue record id"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "blocks",
                      "blocked_by",
                      "related"
                    ]
                  }
                },
                "required": [
                  "issue",
                  "type"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Relation added (and mirrored)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "relations": {
                      "type": "array"
                    },
                    "mirrored": {
                      "type": "boolean"
                    },
                    "already": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid type, body, or self-relation"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Issue not found"
          }
        }
      },
      "delete": {
        "tags": [
          "Issues"
        ],
        "summary": "Remove Issue Relationship",
        "description": "Removes a relation edge and its reciprocal mirror.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Source issue record id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "issue": {
                    "type": "string",
                    "description": "Target issue record id"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "blocks",
                      "blocked_by",
                      "related"
                    ]
                  }
                },
                "required": [
                  "issue",
                  "type"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Relation removed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "relations": {
                      "type": "array"
                    },
                    "unmirrored": {
                      "type": "boolean"
                    },
                    "removed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid type or body"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Issue not found"
          }
        }
      }
    }
  }
}